- name: '[User] Visitor ID follows the precedence order, is normalized and stored
    in the cookie'
  code: |-
    [
      {
        // UI field wins, an ID starting with 16 hex chars keeps that prefix
        data: { _id: '0123456789abcdef-suffix' },
        cookie: 'fedcba9876543210',
        eventData: { _id: 'aaaaaaaaaaaaaaaa' },
        expected: '0123456789abcdef'
      },
      {
        // The cookie wins over event data, non hex values are hashed
        cookie: 'not-a-hex-cookie-value',
        eventData: { _id: 'aaaaaaaaaaaaaaaa' },
        expected: hashHex('not-a-hex-cookie-value', 16)
      },
      {
        eventData: { _id: 'aaaaaaaaaaaaaaaa', 'x-pp-_id': 'bbbbbbbbbbbbbbbb' },
        expected: 'aaaaaaaaaaaaaaaa'
      },
      {
        // Without any ID a random one is generated from the timestamp
        eventData: { client_id: undefined },
        random: true,
        expected: (TIMESTAMP + '' + 1000000000).slice(0, 16)
      }
    ].forEach((scenario) => {
      cleanup();
      setEventData(scenario.eventData);
      mock('getCookieValues', (name) => {
        if (name === COOKIE_NAME && scenario.cookie) return [scenario.cookie];
        return [];
      });
      if (scenario.random) mock('generateRandom', (min, max) => min);

      runCode(createMockData(scenario.data));

      const params = request.params;
      assertThat(params._id).isEqualTo(scenario.expected);
      assertThat(params._id).hasLength(16);
      assertThat(params.cid).isEqualTo(scenario.expected);
      assertApi('setCookie').wasCalledWith(COOKIE_NAME, scenario.expected, EXPECTED_COOKIE_OPTIONS);
      if (scenario.random) assertThat(params.r).isEqualTo('100000000');
    });

    assertApi('getCookieValues').wasCalledWith(COOKIE_NAME);

    callLater(() => {
      assertApi('gtmOnSuccess').wasCalled();
      assertApi('gtmOnFailure').wasNotCalled();
    });
