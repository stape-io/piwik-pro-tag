      empty: undefined,
      'x-pp-c_persid': undefined
    });
    assertThat(request.query.indexOf('x-pp')).isEqualTo(-1);

    callLater(() => {
      assertApi('gtmOnSuccess').wasCalled();
      assertApi('gtmOnFailure').wasNotCalled();
    });
