- name: '[Request] Sends a GET request with the params in the query string and a POST
    for long hits'
  code: |-
    // A fixed cache buster keeps the query string length identical across runs
        mock('generateRandom', (min) => min);

        // The first run carries a 1 character pad so the boundary runs below only differ by the pad length
        let unpaddedQueryLength = 0;
        const scenarios = [
          {
            data: {
              trackingUrl: ' https://example.piwik.pro ',
              parametersToOverride: [{ name: 'pad', value: 'x' }],
              requestHeaders: [
                { name: 'X-Custom-Header', value: 'custom' },
                { name: 'Content-Type', value: 'application/xml' }
              ]
            },
            expectedHeaders: { 'Content-Type': 'application/xml', 'X-Custom-Header': 'custom' }
          },
          {
            // 299 is the highest status code treated as a success
            data: { trackingUrl: 'https://example.piwik.pro/ppms.php' },
            statusCode: 299,
            expectedHeaders: { 'Content-Type': TEXT_CONTENT_TYPE }
          }
        ];

        scenarios.forEach((scenario) => {
          cleanup();
          if (scenario.statusCode) mockResponse(scenario.statusCode);

          runCode(createMockData(scenario.data));
          if (!unpaddedQueryLength) unpaddedQueryLength = request.query.length - 1;

          const params = request.params;
          const visitorId = hashHex(CLIENT_ID, 16);
          assertThat(request.count).isEqualTo(1);
          assertThat(request.endpoint).isEqualTo(EXPECTED_URL);
          assertThat(request.options.method).isEqualTo('GET');
          assertThat(request.options.headers).isEqualTo(scenario.expectedHeaders);
          assertThat(request.body).isUndefined();
          assertParams(params, {
            idsite: SITE_ID,
            url: 'https://example.com/page?a=1&b=two words',
            urlref: 'https://referrer.example.com/',
            action_name: 'Example Page',
            ua: USER_AGENT,
            lang: 'en-us',
            res: '1920x1080',
            cip: '1.2.3.4',
            _id: visitorId,
            cid: visitorId,
            e_c: undefined,
            e_a: undefined,
            e_n: undefined,
            e_v: undefined,
            e_t: undefined,
            idgoal: undefined
          });
          assertThat(params.r).hasLength(9);
          assertApi('setCookie').wasCalledWith(COOKIE_NAME, visitorId, EXPECTED_COOKIE_OPTIONS);
        });

        // Pads the first request to exactly 2048 query string characters (GET) and to one more (POST)
        [
          { length: 2048, method: 'GET' },
          { length: 2049, method: 'POST' }
        ].forEach((boundary) => {
          cleanup();
          let padding = '';
          for (let i = 0; i < boundary.length - unpaddedQueryLength; i++) padding += 'x';

          runCode(createMockData(assign(assign({}, scenarios[0].data), { parametersToOverride: [{ name: 'pad', value: padding }] })));

          const sentLength = (request.bodyQuery || request.query).length;
          assertThat(sentLength, 'query string length for the ' + boundary.method + ' run').isEqualTo(boundary.length);
          assertThat(request.options.method, 'method for a ' + sentLength + ' character query string').isEqualTo(boundary.method);
          assertThat(request.endpoint).isEqualTo(EXPECTED_URL);
          assertThat(request.params.pad).isEqualTo(padding);
          assertThat(request.params.idsite).isEqualTo(SITE_ID);
          if (boundary.method === 'GET') {
            assertThat(request.query).hasLength(2048);
            assertThat(request.body).isUndefined();
          } else {
            // A user Content-Type can't change the JSON POST body, other headers are kept
            assertThat(request.query).isEqualTo('');
            assertThat(JSON.parse(request.body).requests).hasLength(1);
            assertThat(JSON.parse(request.body).requests[0].charAt(0)).isEqualTo('?');
            assertThat(request.bodyQuery).hasLength(2049);
            assertThat(request.options.headers).isEqualTo({
              'Content-Type': 'application/json',
              'X-Custom-Header': 'custom'
            });
          }
        });

        callLater(() => {
          assertApi('gtmOnSuccess').wasCalled();
          assertApi('gtmOnFailure').wasNotCalled();
        });
