    ];
    for (let i = 0; i < 100; i++) {
      manyItems.push({ item_id: 'SKU-' + i, item_name: 'Product ' + i, price: i, quantity: 1 });
      if (cappedProducts.length < 100) cappedProducts.push(['SKU-' + i, 'Product ' + i, [], i, 1, '', '', {}]);
    }
    const mixedItems = [
      { item_name: 'Only Name', price: 5, item_category2: 'Sub' },
      { price: 1, quantity: 2 },
      'string-item',
      null,
      42,
      ['ARR-1', 'Array Product'],
      { item_id: 0, item_name: 'Zero' },
      { item_id: 'NAN-1', price: 'abc', quantity: 'x' }
    ];

    [
      { eventName: 'view_item', expectedType: 'product-detail-view', kind: 'product' },
      {
        // Invalid items are dropped, item_name is the sku fallback and the list is capped at 100
        eventName: 'add_to_cart',
        expectedType: 'add-to-cart',
        kind: 'product',
        eventData: { items: mixedItems.concat(manyItems) },
        expected: { ec_products: cappedProducts }
      },
      {
        eventName: 'remove_from_cart',
        expectedType: 'remove-from-cart',
        kind: 'product',
        eventData: { items: [{ price: 1 }, 'string-item', null] },
        expected: { ec_products: undefined }
      },
      {
        // Empty or invalid product sources are skipped, strings are sent as is
        eventName: 'view_cart',
        expectedType: 'cart-update',
        kind: 'cart',
        eventData: { 'x-pp-ec_products': '', ec_products: 5, ec_items: '[["L-1","Legacy"]]' },
        expected: { ec_products: '[["L-1","Legacy"]]' }
      },
      {
        eventName: 'begin_checkout',
        expectedType: 'cart-update',
        kind: 'cart',
        eventData: {
          'x-pp-ec_products': '[["PP-1","PP Product"]]',
          ec_products: [['EC-1', 'Ec Product']],
          ec_items: '[["L-1","Legacy"]]'
        },
        expected: { ec_products: '[["PP-1","PP Product"]]' }
      },
      {
        eventName: 'add_shipping_info',
        expectedType: 'cart-update',
        kind: 'cart',
        eventData: { 'x-pp-ec_products': { sku: 'OBJ-1' }, ec_products: [['EC-1', 'Ec Product']], ec_items: [] },
        expected: { ec_products: [['EC-1', 'Ec Product']] }
      },
      { eventName: 'add_payment_info', expectedType: 'cart-update', kind: 'cart' },
      {
        // The GA4 mapping wins over the client e_t and x-pp ecommerce values win over event data
        eventName: 'purchase',
        expectedType: 'order',
        kind: 'order',
        data: { e_t: 'inherit' },
        eventData: {
          'x-pp-e_t': 'cart-update',
          revenue: 90,
          'x-pp-revenue': 120,
          'x-pp-ec_st': 110,
          'x-pp-ec_tx': 6,
          'x-pp-ec_sh': 11,
          'x-pp-ec_dt': 1
        },
        expected: { ec_id: 'T-1', revenue: '120', ec_st: '110', ec_tx: '6', ec_sh: '11', ec_dt: '1' }
      }
    ].forEach((scenario) => {
      cleanup();
      setEventData(
        assign(
          {
            event_name: scenario.eventName,
            event_category: 'Ecommerce',
            transaction_id: 'T-1',
            value: 100,
            tax: 5,
            shipping: 10,
            discount_amount: 3,
            currency: 'EUR',
            items: GA4_ITEMS
          },
          scenario.eventData
        )
      );

      runCode(createMockData(assign({ enableEcommerceTracking: true }, scenario.data)));

      const hasTotals = scenario.kind !== 'product';
      const expected = {
        e_t: scenario.expectedType,
        ec_products: EXPECTED_PRODUCTS,
        cur: 'EUR',
        ec_id: scenario.kind === 'order' ? 'T-1' : undefined,
        revenue: hasTotals ? '100' : undefined,
        ec_st: hasTotals ? '100' : undefined,
        ec_tx: hasTotals ? '5' : undefined,
        ec_sh: hasTotals ? '10' : undefined,
        ec_dt: hasTotals ? '3' : undefined
      };
      assertParams(request.params, assign(expected, scenario.expected));
      assertParamsNotSent(request.params, ['e_c', 'e_a', 'e_n', 'e_v', 'idgoal', 'ec_items', 'action_name']);
      // Only the hit with more than 100 products is over the query string limit
      const isLongHit = scenario.eventName === 'add_to_cart';
      assertThat(request.options.method).isEqualTo(isLongHit ? 'POST' : 'GET');
      assertThat(request.query === '').isEqualTo(isLongHit);
    });

    callLater(() => {
      assertApi('gtmOnSuccess').wasCalled();
      assertApi('gtmOnFailure').wasNotCalled();
    });
