setup: |-
  const JSON = require('JSON');
  const Object = require('Object');
  const Promise = require('Promise');
  const callLater = require('callLater');
  const decodeUriComponent = require('decodeUriComponent');
  const getType = require('getType');
  const sha256Sync = require('sha256Sync');

  const TRACKING_URL = 'https://example.piwik.pro/';
  const EXPECTED_URL = 'https://example.piwik.pro/ppms.php';
  const SITE_ID = 'site-123';
  const COOKIE_NAME = '_pk_.' + SITE_ID;
  const CLIENT_ID = '1234567890.1700000000';
  const USER_AGENT = 'Mozilla/5.0 (Test Agent)';
  const TEXT_CONTENT_TYPE = 'text/plain;charset=UTF-8';
  const TIMESTAMP = 1747945830456;
  const EXPECTED_COOKIE_OPTIONS = {
    domain: 'auto',
    path: '/',
    sameSite: 'Lax',
    secure: true,
    'max-age': 34560000,
    httpOnly: false
  };

  // GA4 items and the expected Piwik PRO ec_products conversion
  const GA4_ITEMS = [
    {
      item_id: 12345,
      item_name: 'Product One',
      item_brand: 'Brand One',
      item_variant: 'Red',
      item_category: 'Cat 1',
      item_category2: '',
      item_category3: 3,
      item_category4: null,
      item_category5: 'Cat 5',
      price: '19.99',
      quantity: '2',
      dimension1: 'dim one',
      dimension3: 33,
      dimension4: '',
      dimension: 'no index'
    },
    { item_id: 'SKU-2', item_name: 'Product Two' }
  ];
  const EXPECTED_PRODUCTS = [
    ['12345', 'Product One', ['Cat 1', '3', 'Cat 5'], 19.99, 2, 'Brand One', 'Red', { '1': 'dim one', '3': '33' }],
    ['SKU-2', 'Product Two', [], 0, 1, '', '', {}]
  ];

  // GA4 items and the expected legacy (pre 1.1.0) ec_items conversion
  const LEGACY_ITEMS = [
    { item_id: 'SKU-1', item_name: 'Legacy Product', item_category: 'Cat', price: 50, quantity: 2, item_brand: 'Ignored' },
    'not-an-object'
  ];
  const EXPECTED_LEGACY_EC_ITEMS = [['SKU-1', 'Legacy Product', 'Cat', 50, 2]];

  const assign = (target, source) => {
    if (!source) return target;
    Object.keys(source).forEach((key) => {
      target[key] = source[key];
    });
    return target;
  };

  const hashHex = (value, length) => sha256Sync(value, { outputEncoding: 'hex' }).slice(0, length);

  // Parses the request query string into an object of decoded params
  const parseQuery = (query) => {
    const params = {};
    if (!query) return params;
    query.split('&').forEach((pair) => {
      const parts = pair.split('=');
      params[decodeUriComponent(parts[0])] = decodeUriComponent(parts[1]);
    });
    return params;
  };

  // undefined means not sent, objects and arrays are compared with the parsed JSON param
  const assertParams = (params, expected) => {
    Object.keys(expected).forEach((key) => {
      const value = expected[key];
      const valueType = getType(value);
      if (valueType === 'undefined') {
        assertThat(params[key], key + ' should not be sent').isUndefined();
      } else if (valueType === 'object' || valueType === 'array') {
        assertThat(params[key], key).isDefined();
        assertThat(JSON.parse(params[key]), key).isEqualTo(value);
      } else {
        assertThat(params[key], key).isEqualTo(value);
      }
    });
  };

  const assertParamsNotSent = (params, keys) => {
    keys.forEach((key) => {
      assertThat(params[key], key + ' should not be sent').isUndefined();
    });
  };

  // Captures the outgoing request
  const request = {};

  const captureRequest = (url, options, body) => {
    const queryIndex = url.indexOf('?');
    request.count = request.count + 1;
    request.endpoint = queryIndex === -1 ? url : url.slice(0, queryIndex);
    request.query = queryIndex === -1 ? '' : url.slice(queryIndex + 1);
    request.options = options;
    request.body = body;
    // Long hits are sent as the Tracking API JSON body: { requests: ['?<query string>'] }
    request.bodyQuery = body ? JSON.parse(body).requests[0].slice(1) : undefined;
    request.params = parseQuery(request.bodyQuery || request.query);
  };

  const mockResponse = (statusCode) => {
    mock('sendHttpRequest', (url, options, body) => {
      captureRequest(url, options, body);
      return Promise.create((resolve) => resolve({ statusCode: statusCode, headers: {}, body: '' }));
    });
  };

  const mockRejection = () => {
    mock('sendHttpRequest', (url, options, body) => {
      captureRequest(url, options, body);
      return Promise.create((resolve, reject) => reject({ reason: 'failed' }));
    });
  };

  const setEventData = (overrides) => {
    mock('getAllEventData', () =>
      assign(
        {
          event_name: 'page_view',
          page_location: 'https://example.com/page?a=1&b=two words',
          page_title: 'Example Page',
          page_referrer: 'https://referrer.example.com/',
          client_id: CLIENT_ID,
          user_agent: USER_AGENT,
          language: 'en-us',
          screen_resolution: '1920x1080',
          ip_override: '1.2.3.4'
        },
        overrides
      )
    );
  };

  const createMockData = (overrides) =>
    assign(
      {
        eventType: 'inherit',
        trackingUrl: TRACKING_URL,
        siteId: SITE_ID,
        analyticsStorageConsent: 'optional',
        anonymous: 'inherit',
        enableEcommerceTracking: false,
        useOptimisticScenario: false
      },
      overrides
    );

  // Resets stateful mocks and the captured request between runs
  const cleanup = () => {
    request.count = 0;
    request.endpoint = undefined;
    request.query = undefined;
    request.options = undefined;
    request.body = undefined;
    request.bodyQuery = undefined;
    request.params = undefined;
    setEventData();
    mock('getCookieValues', () => []);
    mock('getRequestHeader', () => undefined);
    mock('setCookie', () => {});
    mock('getTimestampMillis', TIMESTAMP);
    mockResponse(200);
  };

  cleanup();


